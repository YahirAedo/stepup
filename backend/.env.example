# Backend StepUp — variables de entorno
PORT=3000
DATABASE_URL="postgresql://stepup_user:stepup_password@localhost:5432/stepup_db?schema=public"
JWT_SECRET="genera-un-secreto-largo-y-unico"
# Google AI Studio (https://aistudio.google.com/apikey) — obligatoria para arrancar
GEMINI_API_KEY="tu-api-key-de-google-ai-studio"
# Opcional: modelo de Gemini (default: gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
