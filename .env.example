# Copiar a .env y ajustar los valores según el entorno.
# Todas las variables expuestas a la app deben llevar el prefijo EXPO_PUBLIC_.

# URL base del backend StepUp (Express, puerto 3000).
# Ejemplos:
#   Desarrollo en LAN / teléfono físico:  http://<IP-de-tu-PC>:3000
#   Emulador Android:                     http://10.0.2.2:3000
# Si se omite, api.ts la resuelve automáticamente desde Expo.
# EXPO_PUBLIC_API_URL=http://192.168.100.123:3000
